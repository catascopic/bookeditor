{
	"_comment": "The one place formatting lives. Sizes and spacing are in points, indents in inches. Both the editor's on-screen look and the RTF export are generated from this file.",

	"editor": {
		"column_width_in": 6.0
	},

	"inline_code": { "font": "IBM Plex Mono", "bold": true },

	"blocks": {
		"chapter": {
			"font": "Courier New", "size": 14, "bold": true, "align": "center",
			"space_before": 10, "space_after": 10
		},
		"section": {
			"font": "Source Serif 4", "size": 12, "italic": true, "align": "center",
			"space_before": 10, "space_after": 10, "keep_with_next": true
		},
		"body": {
			"font": "Source Serif 4", "size": 10, "first_line_in": 0.5
		},
		"dinkus": {
			"text": "✻ ✻ ✻", "font": "Source Serif 4", "symbol_font": "Segoe UI Symbol", "size": 10, "align": "center",
			"space_before": 10, "space_after": 10, "keep_with_next": true
		},
		"email": {
			"font": "Source Sans 3", "size": 10, "indent_in": 0.5,
			"right_indent_in": 0.5,
			"space_before": 12, "space_after": 12, "para_spacing": 12,
			"_comment": "Emails are boxed. The box and the From/To band take the sender's colour (set in the editor under Senders); default_color is for senders with no colour set.",
			"border_width": 1.5, "box_padding": 6, "default_color": "#5f6368",
			"header_font": "IBM Plex Mono", "header_bold": true,
			"_comment_labels": "The band reads: from_label, sender, to_label, recipient, all on one line. Spaces count. For 'ALICE → BOB' use an empty from_label and ' → ' as to_label.",
			"from_label": "From: ", "to_label": "   To: "
		},
		"journal": {
			"font": "Courier New", "size": 10, "indent_in": 0.5,
			"space_before": 10, "space_after": 10, "para_spacing": 10
		},
		"figure": {
			"_comment": "A picture with a caption. The caption takes its font and size from 'body'.",
			"indent_in": 0.5, "max_width_in": 5.0,
			"space_before": 10, "space_after": 10, "caption_gap": 6
		},
		"code": {
			"font": "IBM Plex Mono", "size": 10, "bold": true, "indent_in": 0.5,
			"space_before": 10, "space_after": 10, "keep_with_next": true
		}
	}
}
